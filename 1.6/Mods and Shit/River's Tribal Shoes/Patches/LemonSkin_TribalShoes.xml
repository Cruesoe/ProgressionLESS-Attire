<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="River_Tribal_sandals"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_NeolithicApparel</li>
      </thingCategories>
    </value>
  </Operation>


  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="River_Tribal_moccasins"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_NeolithicApparel</li>
      </thingCategories>
    </value>
  </Operation>


  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="River_Tribal_mukluks"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_NeolithicApparel</li>
      </thingCategories>
    </value>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="VFET_Tribalwear"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Progression: Core adds the same prerequisite; remove any first so it isn't defined twice -->
        <li Class="PatchOperationRemove">
          <success>Always</success>
          <xpath>Defs/ThingDef[defName="River_Tribal_sandals" or defName="River_Tribal_moccasins" or defName="River_Tribal_mukluks"]/recipeMaker/researchPrerequisite</xpath>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="River_Tribal_sandals" or defName="River_Tribal_moccasins" or defName="River_Tribal_mukluks"]/recipeMaker</xpath>
          <value>
            <researchPrerequisite>VFET_Tribalwear</researchPrerequisite>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
