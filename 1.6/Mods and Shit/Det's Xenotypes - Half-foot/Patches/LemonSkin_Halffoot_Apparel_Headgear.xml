<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- DV_Apparel_ServiceHeadset -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="DV_Apparel_ServiceHeadset"]</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_SpacerHeadgear</li>
      </thingCategories>
    </value>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ApparelLayerDef[defName="DankPyon_InnerHelmet"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="DV_Apparel_ServiceHeadset"]/apparel/layers</xpath>
      <value>
        <layers>
          <li>DankPyon_InnerHelmet</li>
        </layers>
      </value>
    </match>
  </Operation>
</Patch>