<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- VFEC_Toga -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEC_Toga"]/recipeMaker/skillRequirements</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFEC_Toga"]/costStuffCount</xpath>
    <value>
      <costStuffCount>50</costStuffCount>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="VFEC_Toga"]</xpath>
    <value>
      <equippedStatOffsets>
        <SocialImpact>0.1</SocialImpact>
      </equippedStatOffsets>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFEC_Toga"]/apparel/bodyPartGroups</xpath>
    <value>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Legs</li>
      </bodyPartGroups>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFEC_Toga"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_NeolithicApparel</li>
      </thingCategories>
    </value>
  </Operation>
  <!-- VFEC_Apparel_LegionnaireArmor -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFEC_Apparel_LegionnaireArmor"]/recipeMaker/skillRequirements/Crafting</xpath>
    <value>
      <Crafting>6</Crafting>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFEC_Apparel_LegionnaireArmor"]/costStuffCount</xpath>
    <value>
      <costStuffCount>140</costStuffCount>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFEC_Apparel_LegionnaireArmor"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_NeolithicArmor</li>
      </thingCategories>
    </value>
  </Operation>
  <!-- VFEC_Apparel_CenturionArmor -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFEC_Apparel_CenturionArmor"]/recipeMaker/skillRequirements/Crafting</xpath>
    <value>
      <Crafting>8</Crafting>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFEC_Apparel_CenturionArmor"]/costStuffCount</xpath>
    <value>
      <costStuffCount>180</costStuffCount>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFEC_Apparel_CenturionArmor"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_NeolithicArmor</li>
      </thingCategories>
    </value>
  </Operation>
</Patch>
