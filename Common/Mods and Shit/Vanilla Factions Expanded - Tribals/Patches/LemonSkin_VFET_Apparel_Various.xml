<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- VFET_Apparel_TribalLight -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFET_Apparel_TribalLight"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_NeolithicApparel</li>
      </thingCategories>
    </value>
  </Operation>
  <!-- VFET_Apparel_TribalHeavy -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFET_Apparel_TribalHeavy"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_NeolithicApparel</li>
      </thingCategories>
    </value>
  </Operation>
  <!-- VFET_Apparel_TribalWar -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFET_Apparel_TribalWar"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_NeolithicArmor</li>
      </thingCategories>
    </value>
  </Operation>
  <!-- Apparel_WarMask -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_WarMask"]/recipeMaker/researchPrerequisite</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="Apparel_WarMask"]/recipeMaker/researchPrerequisite</xpath>
      <value>
        <researchPrerequisite>LemonSkin_VFET_WarTribalwear</researchPrerequisite>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Apparel_WarMask"]/recipeMaker</xpath>
      <value>
        <researchPrerequisite>LemonSkin_VFET_WarTribalwear</researchPrerequisite>
      </value>
    </nomatch>
  </Operation>
</Patch>
