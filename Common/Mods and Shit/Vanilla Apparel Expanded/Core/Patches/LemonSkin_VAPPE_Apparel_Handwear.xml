<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- VAE_Handwear_Gloves -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VAE_Handwear_Gloves"]/label</xpath>
    <value>
      <label>mittens</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VAE_Handwear_Gloves"]/description</xpath>
    <value>
      <description>A simple pair of mittens.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VAE_Handwear_Gloves"]/techLevel</xpath>
    <value>
      <techLevel>Medieval</techLevel>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VAE_Handwear_Gloves"]/recipeMaker/researchPrerequisite</xpath>
    <value>
      <researchPrerequisite>LemonSkin_RusticClothing</researchPrerequisite>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VAE_Handwear_Gloves"]/equippedStatOffsets</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VAE_Handwear_Gloves"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>LemonSkin_MedievalApparel</li>
      </thingCategories>
    </value>
  </Operation>
</Patch>
