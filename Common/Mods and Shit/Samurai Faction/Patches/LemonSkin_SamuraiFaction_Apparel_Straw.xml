<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- TSFApparel_StrawHat -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TSFApparel_StrawHat"]/label</xpath>
    <value>
      <label>ajirogasa</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TSFApparel_StrawHat"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_MedievalHeadgear</li>
      </thingCategories>
    </value>
  </Operation>
  <!-- TSFApparel_StrawCoat -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TSFApparel_StrawCoat"]/label</xpath>
    <value>
      <label>mino</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TSFApparel_StrawCoat"]/costList</xpath>
    <value>
      <costList>
        <Hay>80</Hay>
      </costList>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TSFApparel_StrawCoat"]/apparel/layers</xpath>
    <value>
      <layers>
        <li>Shell</li>
      </layers>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="TSFApparel_StrawCoat"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_MedievalApparel</li>
      </thingCategories>
    </value>
  </Operation>
</Patch>
