<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[@Name="DankPyon_RugRoyalBase"]/researchPrerequisites</xpath>
  </Operation>
  <!-- Royal rugs -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ResearchProjectDef[defName="DankPyon_RoyalRusticFurniture"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[@Name="DankPyon_RugRoyalBase"]</xpath>
      <value>
        <researchPrerequisites>
          <li>DankPyon_RoyalRusticFurniture</li>
        </researchPrerequisites>
      </value>
    </match>
    <!-- Progression: Aesthetics compatibility -->
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/ResearchProjectDef[defName="MF_RoyalFurniture"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[@Name="DankPyon_RugRoyalBase"]</xpath>
        <value>
          <researchPrerequisites>
            <li>MF_RoyalFurniture</li>
          </researchPrerequisites>
        </value>
      </match>
    </nomatch>
  </Operation>
  <!-- Remove ability to craft silk rugs, supposed to be loot only according to documentation -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[@Name="DankPyon_Rug_LootOnlyBase"]</xpath>
    <value>
      <recipeMaker Inherit="False"></recipeMaker>
    </value>
  </Operation>
</Patch>
