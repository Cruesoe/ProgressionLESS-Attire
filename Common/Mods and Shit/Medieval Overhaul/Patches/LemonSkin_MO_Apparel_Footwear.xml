<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Leather Boots -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Footwear_BootsLeather"]/label</xpath>
    <value>
      <label>jackboots</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Footwear_BootsLeather"]/costStuffCount</xpath>
    <value>
      <costStuffCount>35</costStuffCount>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Footwear_BootsLeather"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>LemonSkin_MedievalApparel</li>
      </thingCategories>
    </value>
  </Operation>
  <!-- Splinted boots -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Footwear_BootsSplinted"]/recipeMaker/skillRequirements/Crafting</xpath>
    <value>
      <Crafting>5</Crafting>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Footwear_BootsSplinted"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>LemonSkin_MedievalArmor</li>
      </thingCategories>
    </value>
  </Operation>
  <!-- Plate boots -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Footwear_BootsPlate"]/recipeMaker/skillRequirements/Crafting</xpath>
    <value>
      <Crafting>7</Crafting>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Footwear_BootsPlate"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>LemonSkin_MedievalArmor</li>
      </thingCategories>
    </value>
  </Operation>
</Patch>
