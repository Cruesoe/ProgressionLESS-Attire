<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- AdornedArmorBase -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[@Name="DankPyon_AdornedArmorBase"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>LemonSkin_MedievalArmor</li>
      </thingCategories>
    </value>
  </Operation>
  <!-- Heavy hauberk (adorned) -->
  <!-- Warrior's armor -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="DankPyon_Apparel_AdornedWarriorArmor"]/apparel/bodyPartGroups/li[.="Legs"]</xpath>
  </Operation>
  <!-- Full plate (adorned) -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Apparel_AdornedHeavyPlate"]/costStuffCount</xpath>
    <value>
      <costStuffCount>150</costStuffCount>
    </value>
  </Operation>
  <!-- DankPyon_Adorned_HeavyMailCoif - Chain coif (adorned) -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]/label</xpath>
    <value>
      <label>chain coif (adorned)</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]/recipeMaker/skillRequirements/Crafting</xpath>
    <value>
      <Crafting>7</Crafting>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]/costStuffCount</xpath>
    <value>
      <costStuffCount>50</costStuffCount>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]</xpath>
    <value>
      <equippedStatOffsets>
        <SocialImpact>0.05</SocialImpact>
      </equippedStatOffsets>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_HeavyMailCoif"]</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_MedievalArmorHeadgear</li>
      </thingCategories>
    </value>
  </Operation>
  <!-- DankPyon_Adorned_FlatTop - Chainveil helm (adorned) -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_FlatTop"]/label</xpath>
    <value>
      <label>chainveil helm (adorned)</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_FlatTop"]/recipeMaker/skillRequirements/Crafting</xpath>
    <value>
      <Crafting>9</Crafting>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_FlatTop"]/costStuffCount</xpath>
    <value>
      <costStuffCount>70</costStuffCount>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_FlatTop"]</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_MedievalArmorHeadgear</li>
      </thingCategories>
    </value>
  </Operation>
  <!-- Great helm (adorned) -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_GreatHelm"]/recipeMaker/skillRequirements/Crafting</xpath>
    <value>
      <Crafting>11</Crafting>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="DankPyon_Adorned_GreatHelm"]</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_MedievalArmorHeadgear</li>
      </thingCategories>
    </value>
  </Operation>
</Patch>
