  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="RBSFE_Faecrown"]/recipeMaker/researchPrerequisite</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="RBSFE_Faecrown"]/recipeMaker/researchPrerequisite</xpath>
      <value>
        <researchPrerequisite>LemonSkin_Leafwear</researchPrerequisite>
