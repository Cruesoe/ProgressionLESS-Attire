<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Combat Extended and its add-ons may already have taken these shields out of apparelRequired -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/*[*]/apparelRequired/li[.="VFEM2_Shield_Round"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/*[*]/apparelRequired/li[.="VFEM2_Shield_Round"]</xpath>
      <value>
        <li>DankPyon_Shield</li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/*[*]/apparelRequired/li[.="VFEM2_Shield_Heater"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/*[*]/apparelRequired/li[.="VFEM2_Shield_Heater"]</xpath>
      <value>
        <li>DankPyon_ShieldHeater</li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM2_Shield_Round" or defName="VFEM2_Shield_Heater"]</xpath>
  </Operation>
</Patch>