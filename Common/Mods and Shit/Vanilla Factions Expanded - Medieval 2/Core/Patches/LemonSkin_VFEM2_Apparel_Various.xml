    </match>
    <nomatch Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="VFEM2_Apparel_JesterOutfit"]/recipeMaker/researchPrerequisite</xpath>
      <value>
        <researchPrerequisite>LemonSkin_RusticClothing</researchPrerequisite>
      </value>
