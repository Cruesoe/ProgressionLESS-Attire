    <value>
      <Crafting>12</Crafting>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFEM2_Apparel_PlateArmorHeavy"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_MedievalArmor</li>
      </thingCategories>
    </value>
  </Operation>
  <!-- VFEM2_Apparel_JesterOutfit -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFEM2_Apparel_JesterOutfit"]/costStuffCount</xpath>
    <value>
      <costStuffCount>80</costStuffCount>
