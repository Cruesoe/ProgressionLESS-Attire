<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- VAE_Apparel_WoodenArmor -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VAE_Apparel_WoodenArmor"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_NeolithicArmor</li>
      </thingCategories>
    </value>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_VFET_WarTribalwear"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>Defs/ThingDef[defName="VAE_Apparel_WoodenArmor"]/recipeMaker/researchPrerequisite</xpath>
      <match Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="VAE_Apparel_WoodenArmor"]/recipeMaker/researchPrerequisite</xpath>
        <value>
          <researchPrerequisite>LemonSkin_VFET_WarTribalwear</researchPrerequisite>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="VAE_Apparel_WoodenArmor"]/recipeMaker</xpath>
        <value>
          <researchPrerequisite>LemonSkin_VFET_WarTribalwear</researchPrerequisite>
        </value>
      </nomatch>
    </match>
  </Operation>
  <!-- VAE_Headgear_StoneWarMask -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VAE_Headgear_StoneWarMask"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>LemonSkin_NeolithicArmorHeadgear</li>
      </thingCategories>
    </value>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/VFETribals.TribalResearchProjectDef[defName="LemonSkin_VFET_WarTribalwear"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>Defs/ThingDef[defName="VAE_Headgear_StoneWarMask"]/recipeMaker/researchPrerequisite</xpath>
      <match Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="VAE_Headgear_StoneWarMask"]/recipeMaker/researchPrerequisite</xpath>
        <value>
          <researchPrerequisite>LemonSkin_VFET_WarTribalwear</researchPrerequisite>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="VAE_Headgear_StoneWarMask"]/recipeMaker</xpath>
        <value>
          <researchPrerequisite>LemonSkin_VFET_WarTribalwear</researchPrerequisite>
        </value>
      </nomatch>
    </match>
  </Operation>
</Patch>
